    def _semantic_void_check(self, vp, vi, vc) -> bool:
        combined_e = max(vp.evidence, vi.evidence)
        combined_r = max(vp.risk, vi.risk)
        combined_u = max(vp.uncertainty, vi.uncertainty)
        return (combined_e == 0 and combined_r == 0 and
                combined_u == 0 and vc.intervention == 0)

    # ── LAYER 2: ONTOLOGICAL RELATION GATE (v16.2 Core) ─────────
    # The intervention is not an independent variable.
    # It is an epistemic extension of risk.
    # Any intervention that cannot be derived from actual risk
    # is an ontological violation — denied before any calculation.
    def _ontological_relation_gate(self, vp, vi, vc) -> Tuple[bool, str]:
        combined_risk     = max(vp.risk, vi.risk)
        combined_evidence = max(vp.evidence, vi.evidence)
        combined_uncertainty = max(vp.uncertainty, vi.uncertainty)

        # The derivability ceiling: maximum permissible intervention
        # derived from the epistemic state — not a threshold, but a law.
        derivability_ceiling = (
