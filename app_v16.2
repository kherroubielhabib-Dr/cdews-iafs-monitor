# ═══════════════════════════════════════════════════════════════
# 🧬 EPISTEMIC VECTOR MODEL
# ═══════════════════════════════════════════════════════════════

@dataclass(frozen=True)
class EpistemicVector:
    evidence:     float
    risk:         float
    uncertainty:  float
    intervention: float


# ═══════════════════════════════════════════════════════════════
# 🧠 SOVEREIGN SEMANTIC ENCODER v16.2
# ═══════════════════════════════════════════════════════════════

class SemanticEncoder:
    evidence_keywords = [
        "no evidence", "normal", "stable", "no signs", "history", "verified",
        "benign", "negative", "clear", "within range", "unremarkable",
        "تاريخية", "ثابتة", "مستقرة", "طبيعي", "سجل", "بيانات", "مؤكد", "سليم", "طبيعية"
    ]
    risk_keywords = [
        "infection", "fever", "severe", "critical", "risk", "prediction",
        "violation", "elevated", "abnormal", "positive", "threat", "danger",
        "خطر", "تنبؤ", "انحراف", "حرجة", "إصابة", "مخالفة", "تجاوز", "تهديد", "ارتفاع"
    ]
    uncertainty_keywords = [
        "possible", "likely", "maybe", "unclear", "suspected", "potential",
        "could be", "cannot rule out", "might", "uncertain",
        "احتمال", "غير مؤكد", "محتمل", "قد يكون", "شك", "غموض", "غير محدد"
    ]
    intervention_keywords = [
        "treat", "start", "action", "block", "ban", "execute", "intervention",
        "administer", "prescribe", "initiate", "begin", "apply", "enforce",
        "حظر", "منع", "قرار", "استباقي", "تنفيذ", "إجراء", "توقيف", "علاج", "إعطاء"
    ]

    @staticmethod
    def encode(text: str) -> EpistemicVector:
        if not text or not text.strip():
            return EpistemicVector(0, 0, 0, 0)
        t = text.lower()
        e = sum(1 for k in SemanticEncoder.evidence_keywords if k in t)
        r = sum(1 for k in SemanticEncoder.risk_keywords if k in t)
        u = sum(1 for k in SemanticEncoder.uncertainty_keywords if k in t)
        i = sum(1 for k in SemanticEncoder.intervention_keywords if k in t)
        norm = max(e + r + u + i, 1)
        return EpistemicVector(e/norm, r/norm, u/norm, i/norm)


