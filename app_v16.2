                "inference":  {"E": round(vi.evidence, 4), "R": round(vi.risk, 4), "U": round(vi.uncertainty, 4)},
                "conclusion": {"I": round(vc.intervention, 4)}
            },
            "sealed":    True,
            "signature": sig,
            "timestamp": round(time.time(), 6),
        }

    # ── MAIN EVALUATE ────────────────────────────────────────────
    def evaluate(self, decision: Dict[str, str],
                 context: Dict = None) -> Dict[str, Any]:
        gate_log = []

